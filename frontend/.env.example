# Veridify frontend — environment template
#
# Copy to `.env.local` (gitignored by Next.js) and edit.
#
# When NEXT_PUBLIC_API_BASE_URL is set, the frontend calls the real FastAPI
# backend (`/account/create`, `/account/balance`, `/account/fund`, `/verify`).
# When it is empty or unset, the app stays in mock mode and uses lib/mock-data.ts.
#
# Local backend:   NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Render preview:  NEXT_PUBLIC_API_BASE_URL=https://veridify.onrender.com
NEXT_PUBLIC_API_BASE_URL=
