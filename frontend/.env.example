# Veridify frontend — environment template
#
# Copy to `.env.local` and edit.
#
# DEFAULT — route the API through Next.js. Browser hits same-origin
# /api/proxy/* and next.config.ts rewrites server-side. No CORS issues
# regardless of which port the dev server uses.
NEXT_PUBLIC_API_BASE_URL=/api/proxy
API_PROXY_TARGET=https://veridify-ai.onrender.com

# DIRECT — talk to the backend straight from the browser. The backend
# must include this origin in its ALLOWED_ORIGINS env var:
#   NEXT_PUBLIC_API_BASE_URL=https://veridify-ai.onrender.com

# LOCAL BACKEND — point at a backend you're running yourself:
#   NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# MOCK — clear NEXT_PUBLIC_API_BASE_URL (or remove this file). The frontend
# falls back to lib/mock-data.ts entirely.
