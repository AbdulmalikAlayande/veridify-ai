# Veridify frontend — environment template
#
# Copy to `.env.local` and edit.
#
# DEFAULT — talk to the deployed backend directly. Dev server runs on port
# 5173 (see package.json) because the backend allows that origin in CORS.
NEXT_PUBLIC_API_BASE_URL=https://veridify-ai.onrender.com

# LOCAL BACKEND — point at a backend you're running yourself:
#   NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# (you'll also want to set ALLOWED_ORIGINS=http://localhost:5173 in backend/.env)

# MOCK — clear NEXT_PUBLIC_API_BASE_URL (or remove this file) and the frontend
# falls back to lib/mock-data.ts entirely.

# OPTIONAL — same-origin proxy via Next.js rewrites. Useful if the backend's
# CORS allowlist doesn't include your dev origin. Both vars required:
#   NEXT_PUBLIC_API_BASE_URL=/api/proxy
#   API_PROXY_TARGET=https://veridify-ai.onrender.com
